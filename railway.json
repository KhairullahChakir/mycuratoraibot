{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "python main.py",
    "numReplicas": 1,
    "multiRegionConfig": null,
    "restartPolicyType": "ALWAYS",
    "sleepApplication": false,
    "cronSchedule": null,
    "healthcheckPath": null,
    "overlapSeconds": 0,
    "drainingSeconds": 45
  }
}
